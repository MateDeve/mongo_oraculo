{
  "name": "buildrel-bootcamp-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference scaffold for a MongoDB Atlas + LangGraph bootcamp agent (RAG, structured-query, hybrid).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "load": "tsx data/load.ts",
    "ui": "tsx src/server.ts",
    "verify": "tsx scripts/verify.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.0",
    "@langchain/mongodb": "^1.3.0",
    "bson": "^7.3.1",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
